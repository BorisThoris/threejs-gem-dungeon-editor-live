{
    "name": "threejs-gem-dungeon-editor",
    "packageManager": "yarn@1.22.22",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "First-person dungeon run: collect gems, spend them at the exit. React Three Fiber, Rapier, Zustand, Electron.",
    "author": "Boris Bostandzhiev",
    "main": "electron/main.cjs",
    "homepage": "./",
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "lint": "eslint .",
        "preview": "vite preview",
        "electron": "electron .",
        "electron-dev": "concurrently \"yarn dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron-pack": "yarn build && electron-builder",
        "electron-dist": "yarn build && electron-builder --publish=never",
        "generate-icon": "node scripts/generate-icon.mjs",
        "test:smoke": "node scripts/smoke-test.mjs",
        "test:layout": "node scripts/layout-check.mjs",
        "test:world": "node scripts/world-check.mjs",
        "test:exploration": "node scripts/exploration-browser-check.mjs",
        "test:watercourse": "node scripts/watercourse-browser-check.mjs",
        "test:ecology": "node scripts/ecology-browser-check.mjs",
        "test:rats": "node scripts/rat-spikes-browser-check.mjs",
        "test:sentry-projection": "node scripts/sentry-projection-check.mjs",
        "test:service-trail": "node scripts/service-trail-check.mjs",
        "test:secret-clue": "node scripts/secret-clue-browser-check.mjs",
        "test:bellcaps": "node scripts/bellcap-browser-check.mjs",
        "test:apses": "node scripts/apse-browser-check.mjs",
        "test:beetles": "node scripts/beetle-browser-check.mjs",
        "test:perf": "node scripts/perf-check.mjs",
        "test:prod": "yarn build && node scripts/prod-check.mjs",
        "test:desktop": "node scripts/desktop-check.mjs",
        "test:pad": "node scripts/pad-check.mjs",
        "test:touch": "node scripts/touch-check.mjs",
        "test:audio": "node scripts/audio-check.mjs",
        "test:room-acoustics": "node scripts/room-acoustics-check.mjs",
        "test:builder-world": "node scripts/builder-world-check.mjs",
        "test:rows": "node scripts/rows-check.mjs",
        "test:run": "node scripts/run-through.mjs",
        "test:walk": "node scripts/walk-run.mjs",
        "test:gameplay": "node scripts/gameplay-check.mjs",
        "test:overlay": "node scripts/overlay-check.mjs",
        "tour": "node scripts/tour.mjs",
        "meta": "node scripts/generate-project-meta.mjs",
        "meta:check": "node scripts/generate-project-meta.mjs --check",
        "shots": "node scripts/capture-project-shots.mjs",
        "social": "node scripts/generate-social-preview.mjs",
        "social:check": "node scripts/generate-social-preview.mjs --check",
        "icons": "node scripts/generate-app-icons.mjs",
        "icons:check": "node scripts/generate-app-icons.mjs --check",
        "meta:refresh": "node scripts/refresh-project-meta.mjs",
        "test:creatures": "node scripts/creature-render-check.mjs"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.6",
        "@react-three/fiber": "^9.3.0",
        "@react-three/rapier": "^2.1.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "three": "^0.180.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@types/three": "^0.180.0",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.2.1",
        "electron": "^38.1.2",
        "electron-builder": "^26.0.12",
        "eslint": "^9.36.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.4.0",
        "knip": "^5.64.1",
        "playwright-core": "1.55.0",
        "terser": "^5.44.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.44.0",
        "vite": "^5.4.20",
        "vite-plugin-eslint2": "^5.0.4",
        "wait-on": "^9.0.1"
    },
    "build": {
        "appId": "com.gemdungeon.demo",
        "productName": "Gem Dungeon",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "!node_modules/**/*"
        ],
        "win": {
            "target": [
                "nsis",
                "zip"
            ],
            "icon": "build/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "mac": {
            "target": [
                "dmg",
                "zip"
            ],
            "icon": "build/icon.png",
            "category": "public.app-category.games"
        },
        "linux": {
            "executableName": "gem-dungeon",
            "target": "AppImage",
            "icon": "build/icon.png",
            "category": "Game"
        }
    }
}
