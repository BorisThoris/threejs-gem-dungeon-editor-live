{
    "name": "threejs-gem-dungeon-editor",
    "packageManager": "yarn@1.22.22",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "First-person dungeon run: collect gems, spend them at the exit. React Three Fiber, Rapier, Zustand, Electron.",
    "author": "Boris Bostandzhiev",
    "main": "electron/main.cjs",
    "homepage": "./",
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit -p tsconfig.app.json",
        "lint": "eslint .",
        "preview": "vite preview",
        "electron": "electron .",
        "electron-dev": "concurrently \"yarn dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron-pack": "yarn build && electron-builder",
        "electron-dist": "yarn build && electron-builder --publish=never",
        "generate-icon": "node scripts/generate-icon.mjs",
        "test:smoke": "node scripts/smoke-test.mjs",
        "test:layout": "node scripts/layout-check.mjs",
        "test:perf": "node scripts/perf-check.mjs",
        "test:prod": "yarn build && node scripts/prod-check.mjs"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.6",
        "@react-three/fiber": "^9.3.0",
        "@react-three/rapier": "^2.1.0",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "three": "^0.180.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.37.0",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@types/three": "^0.180.0",
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.2.1",
        "electron": "^38.1.2",
        "electron-builder": "^26.0.12",
        "eslint": "^9.36.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.20",
        "globals": "^16.4.0",
        "knip": "^5.64.1",
        "playwright-core": "1.55.0",
        "terser": "^5.44.0",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.44.0",
        "vite": "^5.4.20",
        "vite-plugin-eslint2": "^5.0.4",
        "wait-on": "^9.0.1"
    },
    "build": {
        "appId": "com.gemdungeon.demo",
        "productName": "Gem Dungeon",
        "directories": {
            "output": "dist-electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "!node_modules/**/*"
        ],
        "win": {
            "target": ["nsis", "zip"],
            "icon": "build/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "mac": {
            "target": ["dmg", "zip"],
            "icon": "build/icon.png",
            "category": "public.app-category.games"
        },
        "linux": {
            "target": "AppImage",
            "icon": "build/icon.png",
            "category": "Game"
        }
    }
}
